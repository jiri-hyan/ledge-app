; České texty instalátoru Ledge (`customLanguageFiles` v tauri.conf.json). Tauri češtinu nemá: první blok
; jsou všechny řetězce šablony Tauri (stejné klíče jako tauri-bundler languages/English.nsh), druhý naše
; (hooks.nsh). Klíče drž shodné s English.nsh.
LangString addOrReinstall ${LANG_CZECH} "Přidat nebo přeinstalovat součásti"
LangString alreadyInstalled ${LANG_CZECH} "Už nainstalováno"
LangString alreadyInstalledLong ${LANG_CZECH} "${PRODUCTNAME} ${VERSION} už je nainstalovaný. Vyberte, co chcete udělat, a pokračujte tlačítkem Další."
LangString appRunning ${LANG_CZECH} "${PRODUCTNAME} běží. Zavřete ho prosím a zkuste to znovu."
LangString appRunningOkKill ${LANG_CZECH} "${PRODUCTNAME} běží.$\nTlačítkem OK ho zavřete."
LangString chooseMaintenanceOption ${LANG_CZECH} "Vyberte, co se má s instalací udělat."
LangString choowHowToInstall ${LANG_CZECH} "Vyberte, jak chcete ${PRODUCTNAME} nainstalovat."
LangString createDesktop ${LANG_CZECH} "Vytvořit zástupce na ploše"
LangString dontUninstall ${LANG_CZECH} "Neodinstalovat"
LangString dontUninstallDowngrade ${LANG_CZECH} "Neodinstalovat (přechod na starší verzi bez odinstalace tenhle instalátor nedovolí)"
LangString failedToKillApp ${LANG_CZECH} "${PRODUCTNAME} nejde zavřít. Zavřete ho prosím sami a zkuste to znovu."
LangString installingWebview2 ${LANG_CZECH} "Instaluji WebView2…"
LangString newerVersionInstalled ${LANG_CZECH} "Už je nainstalovaná novější verze ${PRODUCTNAME}. Starší verzi instalovat nedoporučujeme — pokud ji opravdu chcete, nejdřív tu současnou odinstalujte. Vyberte, co chcete udělat, a pokračujte tlačítkem Další."
LangString older ${LANG_CZECH} "starší"
LangString olderOrUnknownVersionInstalled ${LANG_CZECH} "V počítači je $R4 verze ${PRODUCTNAME}. Před instalací ji doporučujeme odinstalovat. Vyberte, co chcete udělat, a pokračujte tlačítkem Další."
LangString silentDowngrades ${LANG_CZECH} "Tenhle instalátor nedovolí přejít na starší verzi bez průvodce. Spusťte ho prosím normálně (bez tichého režimu).$\n"
LangString unableToUninstall ${LANG_CZECH} "Odinstalace se nepovedla."
LangString uninstallApp ${LANG_CZECH} "Odinstalovat ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_CZECH} "Před instalací odinstalovat"
LangString unknown ${LANG_CZECH} "neznámá"
LangString webview2AbortError ${LANG_CZECH} "WebView2 se nepodařilo nainstalovat a bez něj Ledge nepoběží. Zkuste instalaci spustit znovu."
LangString webview2DownloadError ${LANG_CZECH} "Stažení WebView2 se nepovedlo – $0"
LangString webview2DownloadSuccess ${LANG_CZECH} "Instalátor WebView2 je stažený"
LangString webview2Downloading ${LANG_CZECH} "Stahuji instalátor WebView2…"
LangString webview2InstallError ${LANG_CZECH} "Instalace WebView2 skončila s chybou $1"
LangString webview2InstallSuccess ${LANG_CZECH} "WebView2 je nainstalovaný"
; zaškrtávátko Tauri „smazat data aplikace“ s obráceným významem (hooks.nsh un.LedgeConfirmLeave)
LangString deleteAppData ${LANG_CZECH} "Ponechat nastavení"

LangString ledgeWelcomeTitle ${LANG_CZECH} "Vítejte u instalace Ledge"
LangString ledgeWelcomeText ${LANG_CZECH} "Ledge je tichý proužek nahoře na obrazovce. Když k němu najedete myší, rozbalí se do šuplíku s kartami, které máte po ruce.$\r$\n$\r$\nInstalace trvá asi minutu a nepotřebuje práva správce.$\r$\n$\r$\nPokračujte tlačítkem Další."
LangString ledgeInstallingTitle ${LANG_CZECH} "Instaluji Ledge"
LangString ledgeInstallingSubtitle ${LANG_CZECH} "Chvilku strpení, nic dalšího nemusíte dělat."
LangString ledgeFinishTitle ${LANG_CZECH} "Hotovo"
LangString ledgeFinishText ${LANG_CZECH} "Ledge je nainstalovaný. Najdete ho nahoře na obrazovce — stačí zajet myší k hornímu okraji."
LangString ledgeRun ${LANG_CZECH} "Spustit Ledge"
LangString ledgeAutostart ${LANG_CZECH} "Spouštět s Windows"
LangString ledgeUninstallTitle ${LANG_CZECH} "Odinstalovat Ledge"
LangString ledgeUninstallSubtitle ${LANG_CZECH} "Ledge se odstraní z tohoto počítače."
LangString ledgeUninstallText ${LANG_CZECH} "Před odinstalací prosím Ledge zavřete. Pak klikněte na Odinstalovat."
LangString ledgeUninstallFolder ${LANG_CZECH} "Složka:"
LangString ledgeKeepSettingsHint ${LANG_CZECH} "Vzhled a vlastní karty zůstanou uložené pro příští instalaci. Poznámky se nemažou nikdy."
