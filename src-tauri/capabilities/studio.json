    "allow-config-export",
    "allow-config-import-preview",
    "allow-desk-hide-all",
    "allow-desk-pin",
    "allow-desk-profile-apply",
    "allow-desk-profile-delete",
    "allow-desk-profile-save",
    "allow-desk-set",
    "allow-desk-unpin",
    "allow-geo-search",
